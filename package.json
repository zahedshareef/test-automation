{
  "name": "qa-automation-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Scope-driven Playwright regression testing for the deployed Blazor WASM test site, with Jira, Octopus Deploy and GitHub Copilot integration.",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "bin": { "qa": "./src/cli.ts" },
  "scripts": {
    "start": "node src/server/index.ts",
    "qa": "node src/cli.ts",
    "test:list": "playwright test --list",
    "test:unit": "node --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@napi-rs/keyring": "^2.1.2",
    "@playwright/test": "^1.65.0",
    "commander": "^15.1.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
